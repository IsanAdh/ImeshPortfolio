---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSection from '../../components/CtaSection.astro';
import { getServices } from '../../lib/content';

const services = await getServices();
---
<BaseLayout title="Services" description="Tax, VAT, company registration, startup finance, audit and advisory services in Nepal.">
  <header class="page-header">
    <div class="container">
      <span class="eyebrow">Services</span>
      <h1>Professional services</h1>
      <p>Practical support from registration to annual compliance, for businesses and individuals in Nepal and NRNs abroad.</p>
    </div>
  </header>
  <div class="container service-grid">
    {services.map((service, index) => (
      <article class="service-card">
        <header>
          <span class="service-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h2><a href={`/services/${service.id}/`}>{service.data.title}</a></h2>
            <p>{service.data.summary}</p>
          </div>
        </header>
        {service.data.highlights.length > 0 && (
          <ul class="check-list">
            {service.data.highlights.map((item) => <li>{item}</li>)}
          </ul>
        )}
        <a class="text-link" href={`/services/${service.id}/`} aria-label={`${service.data.title}: view details`}>View details</a>
      </article>
    ))}
  </div>
  <CtaSection />
</BaseLayout>
