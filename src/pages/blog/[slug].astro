---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { categorySlug } from '../../data/categories';
import { formatDate, getPublishedPosts, readingTime } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      related: posts.filter((p) => p.id !== post.id && p.data.category === post.data.category).slice(0, 3),
    },
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const url = new URL(Astro.url.pathname, Astro.site).toString();
const shareText = encodeURIComponent(`${post.data.title} ${url}`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  image: post.data.cover ? new URL(post.data.cover, Astro.site).toString() : undefined,
  mainEntityOfPage: url,
};
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover} type="article" jsonLd={jsonLd}>
  <header class="page-header">
    <div class="container">
      <div class="meta" style="margin-bottom: 12px">
        <a class="chip" href={`/blog/category/${categorySlug(post.data.category)}/`}>{post.data.category}</a>
        <span>{formatDate(post.data.date)}</span>
        {post.data.updated && <span>Updated {formatDate(post.data.updated)}</span>}
        <span>{readingTime(post)} min read</span>
      </div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
    </div>
  </header>

  <div class="container article-layout">
    <article>
      {post.data.cover && <img src={post.data.cover} alt="" style="border-radius: 12px; margin-bottom: 32px" />}
      <div class="prose"><Content /></div>
      <div class="share">
        <div class="share-text">
          <span class="share-label">Share this article</span>
          <span class="share-sub">Know someone who would find it useful?</span>
        </div>
        <div class="share-actions">
          <a class="share-btn" href={`https://wa.me/?text=${shareText}`} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.200a8.800 8.800 0 0 0-7.600 13.250L3.200 20.800l4.500-1.150A8.800 8.800 0 1 0 12 3.200z" fill="none" stroke="currentColor" stroke-width="1.700" stroke-linejoin="round" /><path d="M9 8c.250-.250.650-.250.850.050l.850 1.200c.150.250.100.550-.100.750l-.450.450c.500.950 1.250 1.700 2.200 2.200l.450-.450c.200-.200.500-.250.750-.100l1.200.850c.300.200.300.600.050.850-.650.700-1.500.900-2.450.650-2.100-.650-3.700-2.200-4.300-4.300C7.800 9.250 8.350 8.500 9 8z" fill="currentColor" /></svg>
            <span>WhatsApp</span>
          </a>
          <a class="share-btn" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.400 20.500v-7.300h2.450l.400-2.900H13.400V8.500c0-.850.250-1.400 1.450-1.400h1.550V4.500c-.300-.050-1.200-.100-2.250-.100-2.250 0-3.750 1.350-3.750 3.850v2.050H7.900v2.900h2.500v7.300z" fill="currentColor" /></svg>
            <span>Facebook</span>
          </a>
          <a class="share-btn" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.800 10v8M6.800 6.400v.010M11 18v-8M11 13.400c0-2 1.250-3.400 3.050-3.400S17 11.200 17 13.400V18" /></svg>
            <span>LinkedIn</span>
          </a>
          <button class="share-btn" type="button" data-copy-link={url}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.800" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.500 13.500a3.500 3.500 0 0 0 5 0l3-3a3.500 3.500 0 0 0-5-5l-1 1M13.500 10.500a3.500 3.500 0 0 0-5 0l-3 3a3.500 3.500 0 0 0 5 5l1-1" /></svg>
            <span data-copy-label>Copy link</span>
          </button>
        </div>
      </div>
      <p class="note">
        This article is general information, not advice for your situation. See the <a href="/legal/disclaimer/">disclaimer</a>.
      </p>
    </article>

    <aside class="article-aside">
      <div class="card">
        <h3>Have a question about this?</h3>
        <p>Ask directly on WhatsApp, or book a consultation for advice on your situation.</p>
        <WhatsAppButton message={`Hello CA Imesh, I read "${post.data.title}" and have a question: `} label="Ask on WhatsApp" />
        <a class="btn btn-outline" href="/book/">Book a Consultation</a>
      </div>
      <div class="card">
        <h3>Get deadline alerts</h3>
        <NewsletterSignup />
      </div>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>Related articles</h2>
        <div class="grid grid-3">{related.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // "Copy link": copies the article address and confirms briefly.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(button.dataset.copyLink ?? location.href);
        if (label) label.textContent = 'Link copied';
      } catch {
        if (label) label.textContent = 'Copy failed';
      }
      setTimeout(() => { if (label) label.textContent = 'Copy link'; }, 2200);
    });
  });
</script>
