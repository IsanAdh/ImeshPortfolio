---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CtaSection from '../components/CtaSection.astro';
import site from '../data/site.json';
import testimonials from '../data/testimonials.json';
import { getPublishedPosts, getServices } from '../lib/content';

const services = await getServices();
const latestPosts = (await getPublishedPosts()).slice(0, 3);
const reviews = testimonials.items as { name: string; role?: string; quote: string }[];

// Headline: everything after the last " for " is set in gold (e.g. "tax, business & startups").
const forAt = site.tagline.lastIndexOf(' for ');
const headlineLead = forAt > -1 ? site.tagline.slice(0, forAt + 5) : site.tagline;
const headlineAccent = forAt > -1 ? site.tagline.slice(forAt + 5) : '';

// Fact strip: verifiable details only; optional stats appear once they are filled in.
// Icons are 24px line drawings, one per fact.
const factIcons = {
  award: '<circle cx="12" cy="9" r="5.2"/><path d="M8.6 13.300 7.200 21l4.800-2.500 4.800 2.500-1.400-7.700"/>',
  calendar: '<rect x="4" y="5.500" width="16" height="14.500" rx="2.500"/><path d="M4 10h16M8.500 3.500v4M15.500 3.500v4"/>',
  people: '<circle cx="9" cy="8.500" r="3.300"/><path d="M3 19.500c.500-3.300 2.900-5 6-5s5.500 1.700 6 5M16 5.500a3.300 3.300 0 0 1 0 6.200M17.500 14.800c2 .600 3.200 2.200 3.500 4.700"/>',
  pin: '<path d="M12 21s-6.500-5.400-6.500-10.600a6.500 6.500 0 0 1 13 0C18.500 15.600 12 21 12 21z"/><circle cx="12" cy="10.400" r="2.400"/>',
  clock: '<circle cx="12" cy="12" r="8.500"/><path d="M12 7.400V12l3.200 2"/>',
};
const facts = [
  { icon: factIcons.award, label: 'Membership', value: 'ICAN · ACAN' },
  { icon: factIcons.calendar, label: 'Years in practice', value: site.stats.yearsInPractice },
  { icon: factIcons.people, label: 'Clients served', value: site.stats.clientsServed },
  { icon: factIcons.pin, label: site.offices.length > 1 ? 'Offices' : 'Office', value: site.offices.map((o) => o.address).join(' | ') },
  { icon: factIcons.clock, label: 'Hours', value: site.hours },
].filter((item) => item.value);

// Labels on the tab beside the portrait, listed top to bottom.
const photoTags = ['CA', 'Tax', 'Advisory'];

// Checklists that can be prepared on request. Shown as a moving wall of cards; each lists three typical steps.
const checklists = [
  { title: 'Startup compliance', items: ['Company registration at OCR', 'PAN and VAT registration', 'Recurring filings calendar'] },
  { title: 'VAT filing', items: ['Sales and purchase registers', 'Input credit reconciled', 'Return filed on time'] },
  { title: 'TDS', items: ['Deduction on each payment', 'Deposit within the deadline', 'Returns and certificates'] },
  { title: 'Company registration', items: ['Right business structure', 'Name approval and documents', 'Registration certificate'] },
  { title: 'Annual compliance', items: ['Audited financial statements', 'Annual return at OCR', 'Income tax return'] },
  { title: 'Audit preparation', items: ['Books closed and reconciled', 'Bank and ledger confirmations', 'Asset and stock records'] },
  { title: 'Income tax return', items: ['Income statements gathered', 'TDS certificates collected', 'Deductions documented'] },
  { title: 'Investor readiness', items: ['Financial model and projections', 'Clean cap table', 'Due diligence folder'] },
];
const checklistColumns = [checklists.filter((_, i) => i % 2 === 0), checklists.filter((_, i) => i % 2 === 1)];

const audiences = [
  {
    icon: '<path d="M4 20V6.500L12 3.500v16.500M12 9.500l8 2.500v8M3 20h18M7.500 9.500v.010M7.500 13v.010M7.500 16.500v.010M16 14.500v.010M16 17.500v.010"/>',
    label: 'Businesses & MSMEs',
    title: 'Compliance that stays on schedule',
    text: 'Company registration, PAN and VAT, regular filings, bookkeeping and audit, handled so compliance does not interrupt the work.',
    href: '/services/',
    cta: 'See all services',
  },
  {
    icon: '<path d="M12 15.500c-1.500-1-3-2.500-3.500-4 1-4 3.500-7 7.500-8 1 4-1 8-4 12zM8.500 11.500 5 12l-1 3 3.500-.500M12.500 15.500 12 19l3-1 .500-3.500M5.500 18.500c-.500 1-1 2-1 2s1-.500 2-1"/><circle cx="14.200" cy="8.800" r="1.300"/>',
    label: 'Startups & founders',
    title: 'Numbers an investor can read',
    text: 'Valuation, financial models and projections, and virtual CFO support for early-stage companies.',
    href: '/services/startup-finance/',
    cta: 'Startup finance',
  },
  {
    icon: '<circle cx="12" cy="8" r="3.800"/><path d="M4.500 20c.800-4 3.800-6 7.500-6s6.700 2 7.500 6"/>',
    label: 'Individuals & NRNs',
    title: 'Clear answers for personal money',
    text: 'Income tax returns, plus plain-language guides and free calculators for everyday finance questions.',
    href: '/blog/',
    cta: 'Read the Knowledge Hub',
  },
];
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        {site.credential && <span class="eyebrow">{site.credential}</span>}
        <h1>{headlineLead}{headlineAccent && <span class="accent">{headlineAccent}</span>}</h1>
      </div>
      <figure class="hero-photo">
        <div class="hero-photo-card">
          <img src={site.photo} alt={`Portrait of ${site.name}`} width="480" height="600" />
        </div>
        <ul class="hero-photo-tags" aria-label="Focus areas">
          {photoTags.map((tag) => <li>{tag}</li>)}
        </ul>
      </figure>
    </div>
  </section>

  <div class="trust-bar">
    <div class="container">
      <div class="trust-items">
        {facts.map((item) => (
          <div class="trust-item">
            <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
            <div>
              <span class="trust-label">{item.label}</span>
              <strong>{item.value.split(' | ').map((line) => <span>{line}</span>)}</strong>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container split">
      <div class="section-head">
        <span class="eyebrow">Services</span>
        <h2>How I can help</h2>
        <p>Tax, compliance and finance support for SMEs, startups, freelancers, NRNs and individuals.</p>
        <a class="text-link" href="/services/">All services</a>
      </div>
      <ol class="index-list">
        {services.map((service) => (
          <li>
            <a href={`/services/${service.id}/`}>
              <div>
                <h3>{service.data.title}</h3>
                <p>{service.data.summary}</p>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Who it's for</span>
        <h2>One practice, three kinds of client</h2>
      </div>
      <div class="pillars">
        {audiences.map((item) => (
          <article class="pillar">
            <h4 class="pillar-label">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.700" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
              <span>{item.label}</span>
            </h4>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a class="text-link" href={item.href}>{item.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-inverse">
    <div class="container band-grid">
      <div>
        <span class="eyebrow">Checklists</span>
        <h2>A checklist for every filing</h2>
        <p class="lead">Tell me what you are working on and I will prepare a clear, step-by-step checklist for it.</p>
        <div class="btn-row">
          <WhatsAppButton label="Request a checklist" message="Hello CA Imesh, I would like a checklist for " />
          <a class="text-link" href="/resources/">Browse resources</a>
        </div>
      </div>
      <div class="checklist-wall">
        {checklistColumns.map((column) => (
          <div class="checklist-col">
            <div class="checklist-track">
              {[false, true].map((clone) =>
                column.map((list) => (
                  <article class="checklist-card" aria-hidden={clone ? 'true' : undefined}>
                    <h3>{list.title}</h3>
                    <ul>
                      {list.items.map((item) => <li>{item}</li>)}
                    </ul>
                  </article>
                ))
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {latestPosts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Knowledge Hub</span>
          <h2>Latest articles</h2>
        </div>
        <div class="grid grid-3">
          {latestPosts.map((post) => <PostCard post={post} />)}
        </div>
        <p style="margin: 40px 0 0"><a class="text-link" href="/blog/">View all articles</a></p>
      </div>
    </section>
  )}

  {reviews.length > 0 && (
    <section class="section section-soft">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Clients</span>
          <h2>What clients say</h2>
        </div>
        <div class="grid grid-3">
          {reviews.map((t) => (
            <figure class="card" style="margin: 0">
              <blockquote class="testimonial" style="margin: 0">“{t.quote}”</blockquote>
              <figcaption class="testimonial-author">{t.name}{t.role && `, ${t.role}`}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaSection />
</BaseLayout>
