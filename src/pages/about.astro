---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/CtaSection.astro';
import site from '../data/site.json';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(page);
---
<BaseLayout title="About" description={page.data.description}>
  <header class="page-header">
    <div class="container">
      {site.credential && <span class="eyebrow">{site.credential}</span>}
      <h1>{page.data.title}</h1>
      <p>Clear, practical answers on taxation, business proposals and projections, compliance and startup finance, so you can focus on running your business.</p>
    </div>
  </header>
  <div class="container article-layout about-layout">
    <div class="prose"><Content /></div>
    <aside class="article-aside">
      <div class="hero-photo"><div class="hero-photo-card"><img src={site.photo} alt={`Portrait of ${site.name}`} width="300" height="375" /></div></div>
      {site.stats.icanMembershipNo && <p class="muted">ICAN Membership No. {site.stats.icanMembershipNo}</p>}
    </aside>
  </div>
  <CtaSection />
</BaseLayout>
