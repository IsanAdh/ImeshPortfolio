---
import site from '../data/site.json';

const links: { href: string; label: string; badge?: string; notice?: boolean }[] = [
  { href: '/about/', label: 'About' },
  { href: '/services/', label: 'Services' },
  { href: '/blog/', label: 'Knowledge Hub' },
  { href: '/resources/', label: 'Resources' },
  { href: '/notices/', label: 'Notice', notice: true },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => path.startsWith(href);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-name">{site.name}</span>
    </a>
    <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" data-nav-toggle>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
    <nav class="nav" aria-label="Main" data-nav>
      <div class="nav-links">
        {links.map((link) => (
          <a href={link.href} class={link.notice ? 'nav-notice' : undefined} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.notice && <span class="live-dot" aria-hidden="true"></span>}
            {link.label}
            {link.badge && <span class="nav-badge">{link.badge}</span>}
          </a>
        ))}
      </div>
      <a class="btn btn-primary" href="/book/">Book a Consultation</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
