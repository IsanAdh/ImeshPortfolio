---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { waLink } from '../lib/whatsapp';
---
<!-- Desktop: floating WhatsApp pill. Mobile: sticky bottom bar with Book + WhatsApp (per the wireframe). -->
<a class="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Chat on WhatsApp" data-track="whatsapp">
  <WhatsAppIcon />
  <span>WhatsApp</span>
</a>
<nav class="mobile-bar" aria-label="Quick contact">
  <a class="btn btn-primary" href="/book/">Book a Consultation</a>
  <a class="btn btn-wa" href={waLink()} target="_blank" rel="noopener" data-track="whatsapp"><WhatsAppIcon /> WhatsApp</a>
</nav>
