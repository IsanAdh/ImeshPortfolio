---
import site from '../data/site.json';
import NewsletterSignup from './NewsletterSignup.astro';
import { waLink } from '../lib/whatsapp';

const socials = Object.entries(site.social).filter(([, url]) => url);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p class="footer-brand">{site.name}</p>
        {site.credential && <p>{site.credential}</p>}
        {socials.length > 0 && (
          <div class="socials">
            {socials.map(([name, url]) => (
              <a href={url} target="_blank" rel="noopener">{name}</a>
            ))}
          </div>
        )}
      </div>
      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href="/services/">Services</a></li>
          <li><a href="/blog/">Knowledge Hub</a></li>
          <li><a href="/resources/">Resources</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/notices/">Notices</a></li>
        </ul>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href={waLink()} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          {site.offices.map((office) => <li>{office.city}</li>)}
        </ul>
      </div>
      <div>
        <h4>Tax deadlines & updates</h4>
        <p>Budget changes and filing reminders, sent occasionally.</p>
        <NewsletterSignup />
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Mutex Consulting Group. All rights reserved.</span>
      <span>
        <a href="/legal/disclaimer/">Disclaimer</a> · <a href="/legal/privacy/">Privacy</a> · <a href="/legal/terms/">Terms</a>
      </span>
    </div>
  </div>
</footer>
