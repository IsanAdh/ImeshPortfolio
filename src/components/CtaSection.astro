---
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  title?: string;
  text?: string;
  message?: string;
}
const {
  title = 'Talk to a CA today',
  text = 'Book a 30-minute consultation, or send a quick question on WhatsApp.',
  message,
} = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="callout">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href="/book/">Book 30-min Call</a>
        <WhatsAppButton message={message} label="WhatsApp" />
      </div>
    </div>
  </div>
</section>
