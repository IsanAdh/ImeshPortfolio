---
import type { CollectionEntry } from 'astro:content';
import { categorySlug } from '../data/categories';
import { formatDate, readingTime } from '../lib/content';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const href = `/blog/${post.id}/`;
---
<article class="card post-card">
  {post.data.cover && (
    <a class="card-media" href={href} tabindex="-1">
      <img src={post.data.cover} alt="" loading="lazy" />
    </a>
  )}
  <div class="post-card-body">
    <a class="chip" href={`/blog/category/${categorySlug(post.data.category)}/`}>{post.data.category}</a>
    <h3><a href={href}>{post.data.title}</a></h3>
    <div class="meta">
      <span>{formatDate(post.data.date)}</span>
      <span class="meta-dot" aria-hidden="true"></span>
      <span>{readingTime(post)} min read</span>
    </div>
    <p>{post.data.description}</p>
    <a class="post-more" href={href} aria-label={`Read article: ${post.data.title}`}>Read article</a>
  </div>
</article>
